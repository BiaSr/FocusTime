<Window x:Class="FocusTime.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusTime"
        Height="550"
        Width="900">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- DISCIPLINAS -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Disciplinas" FontSize="20" FontWeight="Bold"/>

            <TextBlock Text="Nome" Margin="0,10,0,0"/>
            <TextBox Text="{Binding NomeDisciplina}" />

            <TextBlock Text="Carga Horária" Margin="0,10,0,0"/>
            <TextBox Text="{Binding CargaHoraria}" />

            <TextBlock Text="Tipo" Margin="0,10,0,0"/>
            <ComboBox SelectedValue="{Binding TipoDisciplina}" SelectedValuePath="Content">
                <ComboBoxItem Content="Teórica"/>
                <ComboBoxItem Content="Prática"/>
            </ComboBox>

            <Button Content="Adicionar Disciplina"
            Margin="0,10,0,10"
            Click="AdicionarDisciplina_Click"/>

            <DataGrid ItemsSource="{Binding Disciplinas}"
              SelectedItem="{Binding DisciplinaSelecionada}"
              AutoGenerateColumns="False"
              Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Carga" Binding="{Binding CargaHoraria}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>


        <!-- ATIVIDADES -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Atividades" FontSize="20" FontWeight="Bold"/>

            <TextBlock Text="Descrição" Margin="0,10,0,0"/>
            <TextBox Text="{Binding DescricaoAtividade}" />

            <TextBlock Text="Data de entrega" Margin="0,10,0,0"/>
            <DatePicker SelectedDate="{Binding DataEntrega}" />

            <TextBlock Text="Tipo" Margin="0,10,0,0"/>
            <ComboBox SelectedValue="{Binding TipoAtividade}"
              SelectedValuePath="Content">
                <ComboBoxItem Content="Prova"/>
                <ComboBoxItem Content="Trabalho"/>
                <ComboBoxItem Content="Revisão"/>
            </ComboBox>

            <Button Content="Adicionar Atividade"
            Margin="0,10,0,10"
            Click="AdicionarAtividade_Click"/>

            <DataGrid ItemsSource="{Binding Atividades}"
              AutoGenerateColumns="False"
              Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                    <DataGridTextColumn Header="Entrega" Binding="{Binding DataEntrega}" Width="120"/>
                    <DataGridTextColumn Header="Disciplina" Binding="{Binding Disciplina.Nome}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

    </Grid>
</Window>